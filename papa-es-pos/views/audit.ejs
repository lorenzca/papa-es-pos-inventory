<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Audit Trail</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="/css/style.css?v=<%= locals.assetVersion || 0 %>" />
  <script>tailwind.config={theme:{extend:{colors:{papaRed:'#8B0000',papaGold:'#D4AF37'}}}}</script>
</head>
<body class="text-white p-4 md:p-6 bg-slate-900">
  <%- include('partials/header', { user, pageTitle: 'Full Audit Trail' }) %>

  <nav class="mb-4 flex flex-wrap gap-2 text-sm">
    <a href="/dashboard" class="px-3 py-2 rounded bg-white/10 hover:bg-white/20">Dashboard</a>
    <a href="/pos" class="px-3 py-2 rounded bg-white/10 hover:bg-white/20">POS</a>
    <a href="/reports" class="px-3 py-2 rounded bg-white/10 hover:bg-white/20">Reports</a>
    <a href="/logout" class="px-3 py-2 rounded bg-red-800/80 hover:bg-red-700">Logout</a>
  </nav>

  <section class="grid lg:grid-cols-3 gap-4 mb-4">
    <div class="metric-card bg-slate-800 border border-slate-700 p-4 rounded-lg">
      <p class="text-xs text-white/60">Total Events Loaded</p>
      <p class="text-2xl font-bold"><%= logs.length %></p>
    </div>
    <div class="metric-card lg:col-span-2 bg-slate-800 border border-slate-700 p-4 rounded-lg">
      <canvas id="auditChart" height="90"></canvas>
    </div>
  </section>

  <section class="card-panel bg-slate-900 border border-slate-700 p-4 rounded-lg overflow-x-auto">
    <div class="mb-3 flex items-center justify-between gap-2">
      <h2 class="text-lg font-semibold text-papaGold">Activity Feed</h2>
      <input id="auditSearch" placeholder="Filter by user, action, entity..." class="bg-slate-800 border border-slate-700 p-2 rounded text-sm w-full max-w-sm text-white focus:outline-none focus:border-papaGold" />
    </div>

    <table class="w-full text-sm" id="auditTable">
      <thead>
        <tr class="text-white/60 border-b border-slate-700 text-left">
          <th class="py-2.5">Time</th>
          <th>User</th>
          <th>Role</th>
          <th>Action</th>
          <th>Entity</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody>
      <% if (!logs.length) { %>
        <tr>
          <td colspan="6" class="py-4 text-center text-white/50">No audit activity logged yet.</td>
        </tr>
      <% } %>
      <% logs.forEach(log => { 
            let d = log.parsedDetails || log.details || {};
            if (typeof d === 'string') {
              try { d = JSON.parse(d); } catch (e) { d = {}; }
            }
      %>
        <tr class="border-t border-slate-800 hover:bg-slate-800/40 align-top transition">
          <td class="py-2.5 text-xs text-white/60 whitespace-nowrap"><%= log.created_at %></td>
          <td class="font-medium text-white"><%= log.full_name || 'System' %></td>
          <td><span class="text-xs text-white/60 uppercase"><%= log.role || '-' %></span></td>
          <td>
            <% 
              let badgeColor = 'bg-slate-700 text-white';
              if (log.action.includes('APPROVED') || log.action.includes('COMPLETED')) badgeColor = 'bg-emerald-950 border border-emerald-500/40 text-emerald-300';
              if (log.action.includes('REJECTED') || log.action.includes('VOID')) badgeColor = 'bg-red-950 border border-red-500/40 text-red-300';
              if (log.action.includes('OPENED') || log.action.includes('UPDATED')) badgeColor = 'bg-amber-950 border border-amber-500/40 text-amber-300';
            %>
            <span class="px-2 py-0.5 text-xs font-semibold rounded <%= badgeColor %>"><%= log.action %></span>
          </td>
          <td class="text-xs text-white/60"><%= log.entity_type %><%= log.entity_id ? (' #' + log.entity_id) : '' %></td>
          <td class="text-xs text-white/80 max-w-md">
            <% if (log.action === 'SALE_COMPLETED') { %>
              <span class="font-semibold text-white"><%= d.or_number || 'Sale' %></span> · Total: ₱<%= Number(d.total || 0).toFixed(2) %> (<%= d.payment_method %>)<% if (d.table_number) { %> <span class="text-white/50">· <%= d.table_number %></span><% } %>

            <% } else if (log.action === 'USER_LOGIN' || log.action === 'USER_LOGOUT') { %>
              <span>Logged in as <strong class="text-papaGold"><%= d.username %></strong> (<%= d.role %>)</span>

            <% } else if (log.action.includes('STOCK_') || log.action === 'RESTOCK' || log.action === 'DEDUCT') { %>
              <span>
                <strong class="text-white"><%= d.ingredient_name || 'Item' %></strong>: 
                <%= (d.quantity_change > 0 ? '+' : '') + (d.quantity_change ?? d.qty ?? '') %> 
                <span class="text-white/50">(<%= d.reason || d.movement_type || 'Stock Change' %>)</span>
              </span>

            <% } else if (log.action.includes('VOID')) { %>
              <div class="space-y-0.5">
                <div><span class="font-semibold text-white"><%= d.item_name || 'Void Action' %></span> <% if (d.reason) { %><span class="text-white/50">("<%= d.reason %>")</span><% } %></div>
                <% if (d.authorized_by) { %>
                  <div class="text-papaGold font-medium">Authorized by: <%= d.authorized_by %></div>
                <% } %>
                <% if (d.applied) { %>
                  <div class="text-white/50 text-[11px]">Outcome: <%= d.applied %><%= d.voided_qty ? ` (Qty: ${d.voided_qty})` : '' %></div>
                <% } %>
              </div>

            <% } else if (log.action.includes('TABLE_')) { %>
              <span><%= d.table_number %></span> · Subtotal: ₱<%= Number(d.subtotal || 0).toFixed(2) %> (<%= d.item_count %> items)

            <% } else if (d && Object.keys(d).length) { %>
              <span class="text-white/70 font-mono text-[11px]"><%= Object.entries(d).map(([k, v]) => `${k}: ${v}`).join(' · ') %></span>

            <% } else { %>
              <span class="text-white/40">—</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </section>

  <script>
    const logs = <%- JSON.stringify(logs) %>;
    const grouped = logs.reduce((acc, l) => {
      acc[l.action] = (acc[l.action] || 0) + 1;
      return acc;
    }, {});

    const chartLabels = Object.keys(grouped).slice(0, 10);
    const chartData = Object.values(grouped).slice(0, 10);

    new Chart(document.getElementById('auditChart'), {
      type: 'bar',
      data: {
        labels: chartLabels.length ? chartLabels : ['No Activity'],
        datasets: [{
          data: chartData.length ? chartData : [0],
          backgroundColor: 'rgba(212, 175, 55, 0.75)',
          borderRadius: 6
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { 
          y: { beginAtZero: true, ticks: { color: '#94a3b8', stepSize: 1 } }, 
          x: { ticks: { color: '#94a3b8' } } 
        }
      }
    });

    document.getElementById('auditSearch').addEventListener('input', (event) => {
      const q = event.target.value.toLowerCase();
      document.querySelectorAll('#auditTable tbody tr').forEach((row) => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
      });
    });
  </script>
</body>
</html>
