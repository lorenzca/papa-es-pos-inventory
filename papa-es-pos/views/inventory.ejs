<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Inventory</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css?v=<%= locals.assetVersion || 0 %>" />
  <script>tailwind.config={theme:{extend:{colors:{papaRed:'#8B0000',papaGold:'#D4AF37'}}}}</script>
</head>
<body class="text-white p-4 md:p-6">
  <%- include('partials/header', { user, pageTitle: 'Inventory & Stock Control' }) %>

  <nav class="mb-4 flex flex-wrap gap-2 text-sm">
    <% if (user && ['OWNER','MANAGER'].includes(user.role)) { %>
      <a href="/dashboard" class="px-3 py-2 rounded bg-white/10 hover:bg-white/20">Dashboard</a>
      <a href="/menu" class="px-3 py-2 rounded bg-white/10 hover:bg-white/20">Menu</a>
      <a href="/reports" class="px-3 py-2 rounded bg-white/10 hover:bg-white/20">Reports</a>
    <% } %>
    <a href="/logout" class="px-3 py-2 rounded bg-red-800/80 hover:bg-red-700">Logout</a>
  </nav>

  <!-- PANEL PICKER -->
  <section class="card-panel p-4 mb-4">
    <p class="text-xs uppercase tracking-wide text-white/50 mb-2">Choose what to do</p>
    <div class="flex flex-wrap gap-2">
      <button type="button" onclick="switchInvTab('stock')" id="tab-stock" class="tab-btn is-active">Current Stock</button>
      <% if (user && ['OWNER', 'MANAGER'].includes(user.role)) { %>
        <button type="button" onclick="openNewIntake()" id="tab-intake" class="tab-btn">Receive Delivery</button>
        <button type="button" onclick="switchInvTab('history')" id="tab-history" class="tab-btn">Delivery History</button>
      <% } %>
    </div>
  </section>

  <!-- TAB 1: CURRENT STOCK -->
  <div id="view-stock" class="inv-view block space-y-4">
    <section class="card-panel p-4">
      <div class="mb-3">
        <h2 class="text-xl text-papaGold font-semibold">Stock Inventory</h2>
        <p class="text-xs text-white/60">
          <%= user && user.role === 'KITCHEN' ? 'Click any row or button to log waste, spoilage, or prep loss.' : 'Every ingredient, on-hand count, and reorder par level.' %>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
        <p class="text-xs text-white/50"><%= ingredients.length %> item(s) on file.</p>
        <div class="flex items-center gap-2">
          <!-- Low Stock Toggle -->
          <button type="button" id="lowStockToggleBtn" onclick="toggleLowStockFilter()" 
                  class="h-8 px-3 text-xs font-semibold rounded bg-slate-800 text-amber-400 border border-amber-500/40 hover:bg-amber-500/20 transition whitespace-nowrap">
            Show Low Stock Only
          </button>
          
          <!-- Search Field -->
          <input type="text" id="inventorySearch" oninput="filterInventory()" autocomplete="off"
                 placeholder="Search ingredients..."
                 class="h-8 px-3 text-xs bg-slate-800 text-white border border-slate-700 rounded focus:border-papaGold focus:outline-none w-48 sm:w-56" />
          
          <!-- Search Button -->
          <button type="button" onclick="filterInventory()" 
                  class="h-8 px-3 text-xs font-semibold rounded bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 transition">
            Search
          </button>
        </div>
      </div>

      <div class="w-full overflow-x-auto">
        <table class="w-full text-sm table-auto" id="inventoryTable">
          <thead>
            <tr class="border-b border-slate-700/80 text-white/70">
              <th class="text-left py-2">Name</th>
              <th class="text-right py-2 w-28">Current Stock</th>
              <th class="text-center py-2 w-16">Unit</th>
              <th class="text-right py-2 w-24">Reorder Par</th>
              <% if (user && ['OWNER', 'MANAGER'].includes(user.role)) { %>
                <th class="text-right py-2 w-24">Unit Cost</th>
              <% } %>
              <th class="text-center py-2 w-24">Action</th>
            </tr>
          </thead>
          <tbody>
          <% ingredients.forEach(i => { 
              const isLow = Number(i.stock_qty) <= Number(i.reorder_level);
          %>
            <tr class="inventory-row border-t border-slate-700 hover:bg-white/5 transition cursor-pointer"
                data-search="<%= i.ingredient_name %> <%= i.unit_measure %>"
                data-is-low="<%= isLow ? 'true' : 'false' %>"
                data-id="<%= i.id %>"
                data-name="<%= i.ingredient_name %>"
                data-unit="<%= i.unit_measure %>"
                data-stock="<%= Number(i.stock_qty).toFixed(2) %>"
                data-cost="<%= Number(i.unit_cost || 0).toFixed(2) %>">
              <td class="py-2.5" onclick="openRestockModal('<%= i.id %>', '<%= i.ingredient_name %>', '<%= i.unit_measure %>', '<%= Number(i.stock_qty).toFixed(2) %>', '<%= Number(i.unit_cost || 0).toFixed(2) %>')">
                <span class="flex items-center gap-2">
                  <span><%= i.ingredient_name %></span>
                  <% if (isLow) { %>
                    <span class="low-badge text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-400 border border-amber-500/30">Low</span>
                  <% } %>
                </span>
              </td>
              <td class="text-right <%= isLow ? 'text-amber-400 font-semibold' : '' %>" onclick="openRestockModal('<%= i.id %>', '<%= i.ingredient_name %>', '<%= i.unit_measure %>', '<%= Number(i.stock_qty).toFixed(2) %>', '<%= Number(i.unit_cost || 0).toFixed(2) %>')">
                <%= Number(i.stock_qty).toFixed(2) %>
              </td>
              <td class="text-center text-white/60"><%= i.unit_measure %></td>
              <td class="text-right text-white/60"><%= i.reorder_level %></td>
              <% if (user && ['OWNER', 'MANAGER'].includes(user.role)) { %>
                <td class="text-right">₱<%= Number(i.unit_cost || 0).toFixed(2) %></td>
              <% } %>
              <td class="text-center py-2.5">
                <button type="button" 
                        onclick="event.stopPropagation(); openRestockModal('<%= i.id %>', '<%= i.ingredient_name %>', '<%= i.unit_measure %>', '<%= Number(i.stock_qty).toFixed(2) %>', '<%= Number(i.unit_cost || 0).toFixed(2) %>')"
                        class="text-xs px-2.5 py-1 rounded bg-slate-800 hover:bg-papaGold hover:text-black border border-slate-700 transition font-medium">
                  <%= user && user.role === 'KITCHEN' ? 'Log Waste' : 'Adjust' %>
                </button>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
        <p id="inventoryEmpty" class="hidden text-sm text-white/60 py-3">No ingredient matches that filter.</p>
        <% if (!ingredients.length) { %>
          <p class="text-sm text-white/60 py-3">No ingredients on file.</p>
        <% } %>
      </div>
    </section>
  </div>

  <% if (user && ['OWNER', 'MANAGER'].includes(user.role)) { %>
    <!-- TAB 2: RECEIVE DELIVERY -->
    <div id="view-intake" class="inv-view hidden space-y-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
        
        <!-- Left Column: Receive Delivery / PO Form -->
        <div class="lg:col-span-7 xl:col-span-8 card-panel p-4 flex flex-col min-h-[75vh]">
          <div class="flex justify-between items-center border-b border-slate-700/60 pb-3 mb-4 shrink-0">
            <div>
              <h3 id="intakeTitleText" class="text-base text-papaGold font-semibold">Receive Delivery</h3>
              <p class="text-xs text-white/60">Enter quantities in kg or g. Recipe units convert automatically.</p>
            </div>
            <button type="button" onclick="autoFillSuggestedOrders()" class="mini-btn">
              Suggest Restock
            </button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4 shrink-0">
            <div>
              <div class="flex items-center justify-between mb-1">
                <label class="text-xs text-white/60 block">Order Guide</label>
                <button type="button" id="deleteGuideBtn" onclick="deleteCurrentGuide()" 
                        class="hidden text-[10px] text-red-400 hover:text-red-300 font-semibold transition">
                  Delete Preset
                </button>
              </div>
              <select id="guideSelect" onchange="loadGuideItems()" class="w-full bg-slate-800 border border-slate-700 rounded p-2 text-xs text-white focus:border-papaGold focus:outline-none">
                <option value="">Select a Preset Guide</option>
              </select>
            </div>
            <div>
              <label class="text-xs text-white/60 block mb-1">Supplier / Vendor</label>
              <input type="text" id="supplierNameInput" class="w-full bg-slate-800 border border-slate-700 rounded p-2 text-xs text-white focus:border-papaGold focus:outline-none" placeholder="e.g. Wet Market 1" />
            </div>
            <div id="expectedDateContainer">
              <label class="text-xs text-white/60 block mb-1">Expected Arrival</label>
              <input type="date" id="expectedDateInput" class="w-full bg-slate-800 border border-slate-700 rounded p-2 text-xs text-white focus:border-papaGold focus:outline-none" />
            </div>
          </div>

          <div class="relative shrink-0 mb-3">
            <div class="flex items-center gap-2">
              <input type="text" id="ingredientSearchInput" autocomplete="off" onfocus="showIngredientDropdown()" oninput="filterIngredientDropdown()" 
                     placeholder="Search and add ingredient..." class="flex-1 bg-slate-800 border border-slate-700 focus:border-papaGold focus:outline-none p-2 rounded text-xs text-white placeholder-white/40" />
              <button type="button" onclick="showIngredientDropdown(); filterIngredientDropdown();" class="mini-btn">
                Search
              </button>
            </div>
            <div id="ingredientResults" class="hidden absolute left-0 right-0 top-full mt-1 z-50 max-h-44 overflow-y-auto bg-slate-800 border border-slate-700 rounded shadow-lg divide-y divide-slate-700/50">
              <% ingredients.forEach(i => { %>
                <button type="button" class="ingredient-result-item w-full text-left p-2 text-xs hover:bg-papaGold hover:text-black flex items-center justify-between transition"
                        data-id="<%= i.id %>" data-name="<%= i.ingredient_name %>" data-unit="<%= i.unit_measure %>" data-cost="<%= i.unit_cost %>"
                        data-stock="<%= i.stock_qty %>" data-reorder="<%= i.reorder_level %>" data-hist="<%= i.historical_avg || i.unit_cost %>"
                        data-search="<%= i.ingredient_name %> <%= i.unit_measure %>" onclick="selectIngredientItem(this)">
                  <span><%= i.ingredient_name %></span>
                  <span class="text-[11px] opacity-70">Par: <%= i.reorder_level %> <%= i.unit_measure %></span>
                </button>
              <% }) %>
              <div id="ingredientNoResults" class="hidden p-3 text-center text-xs text-white/40">No ingredient matching that search.</div>
            </div>
          </div>

          <div class="flex-1 overflow-y-auto border border-slate-700/60 rounded bg-black/20">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-800/90 text-white sticky top-0 border-b border-slate-700">
                <tr>
                  <th class="p-2.5">Name</th>
                  <th class="p-2.5 text-center w-20">Unit</th>
                  <th class="p-2.5 text-right w-24">Qty</th>
                  <th class="p-2.5 text-right w-32">Cost / Unit</th>
                  <th class="p-2.5 text-right w-28">Subtotal</th>
                  <th class="p-2.5 text-center w-8"></th>
                </tr>
              </thead>
              <tbody id="receivingTableBody" class="divide-y divide-slate-800/60">
                <tr><td colspan="6" class="p-6 text-center text-white/40">Select an order guide or search an ingredient above.</td></tr>
              </tbody>
            </table>
          </div>

          <div class="pt-3 border-t border-slate-700/60 shrink-0 space-y-2.5 mt-3">
            <div id="saveGuideDrawer" class="hidden bg-slate-800/95 border border-slate-700 p-2.5 rounded transition-all">
              <div id="guideNameInputRow" class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="flex-1 flex items-center gap-2">
                  <span class="text-xs text-white/70 shrink-0">Preset Name:</span>
                  <input type="text" id="inlineGuideNameInput" placeholder="e.g. Meat Shop 2 or Morning Veggies" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-xs text-white focus:border-papaGold focus:outline-none" />
                </div>
                <div class="flex items-center gap-2">
                  <button type="button" onclick="cancelSaveGuide()" class="mini-btn">Cancel</button>
                  <button type="button" onclick="confirmSaveGuide()" class="bg-papaGold text-black font-semibold text-xs px-3 py-1 rounded">Apply Name</button>
                </div>
              </div>
              <div id="guideOverwriteConfirmRow" class="hidden flex items-center justify-between gap-3 text-xs">
                <span class="text-amber-400">A preset with this name already exists. Overwrite its saved items?</span>
                <div class="flex items-center gap-2">
                  <button type="button" onclick="cancelOverwrite()" class="mini-btn">Cancel</button>
                  <button type="button" onclick="applyOverwrite()" class="bg-amber-500 text-black font-semibold text-xs px-3 py-1 rounded">Yes, Overwrite</button>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between gap-3 w-full">
              <div class="flex flex-col shrink-0">
                <span class="text-[10px] uppercase tracking-wide text-white/40 mb-1">Total Amount</span>
                <strong id="intakeTotal" class="text-xl font-bold text-papaGold leading-none">₱0.00</strong>
              </div>
              <div class="flex flex-wrap justify-end items-center gap-2 shrink-0">
                <button type="button" id="saveGuideBtn" onclick="toggleSaveGuideDrawer()" class="mini-btn">Save Preset</button>
                <button type="button" id="savePendingOrderBtn" onclick="submitPendingOrder()" class="mini-btn">Place Order (Pending)</button>
                <button type="button" id="submitDeliveryBtn" onclick="submitFinalDelivery()" class="bg-papaGold text-black px-4 py-2 rounded font-bold text-xs">Confirm & Post Stock</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Queue & Recent Intakes -->
        <div class="lg:col-span-5 xl:col-span-4 space-y-4">
          <div class="card-panel p-4">
            <div class="flex items-center justify-between mb-2 pb-2 border-b border-slate-700/60">
              <h3 class="text-xs font-semibold text-papaGold uppercase tracking-wide">Pending Orders</h3>
              <span class="text-[11px] text-white/50"><%= (locals.pendingOrders || []).length %> open</span>
            </div>

            <% if (locals.pendingOrders && pendingOrders.length > 0) { %>
              <div class="max-h-64 overflow-y-auto space-y-2 pr-1">
                <% pendingOrders.forEach(po => { %>
                  <div class="p-2.5 rounded bg-black/20 border border-slate-700/50 flex items-center justify-between gap-2 text-xs">
                    <div>
                      <span class="text-white block font-medium"><%= po.supplier_name || 'Vendor' %></span>
                      <span class="text-[10px] text-white/40 block">Due: <%= po.expected_date ? new Date(po.expected_date).toLocaleDateString() : '—' %></span>
                      <span class="text-white/80">₱<%= Number(po.total_cost).toFixed(2) %></span>
                    </div>
                    <button type="button" data-po-id="<%= po.id %>" onclick="openReceiveIntake(this.dataset.poId)" class="mini-btn">
                      Receive
                    </button>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-xs text-white/40 py-4 text-center">No pending orders in the queue.</p>
            <% } %>
          </div>

          <div class="card-panel p-4">
            <div class="flex items-center justify-between mb-2 pb-2 border-b border-slate-700/60">
              <h3 class="text-xs font-semibold text-white">Recent Intakes</h3>
              <button type="button" onclick="switchInvTab('history')" class="text-[11px] text-papaGold hover:underline">
                View All History →
              </button>
            </div>

            <% if (locals.intakeHistory && intakeHistory.length > 0) { %>
              <div class="max-h-56 overflow-y-auto space-y-2 pr-1">
                <% intakeHistory.slice(0, 5).forEach(dh => { %>
                  <div class="p-2 rounded bg-black/20 border border-slate-700/40 text-xs flex justify-between items-center">
                    <div class="truncate mr-2">
                      <span class="text-white/90 block truncate"><%= dh.supplier_name || 'Vendor' %></span>
                      <span class="text-[10px] text-white/40"><%= dh.received_at ? new Date(dh.received_at).toLocaleDateString() : '—' %></span>
                    </div>
                    <span class="text-white/80 shrink-0">₱<%= Number(dh.total_cost || 0).toFixed(2) %></span>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-xs text-white/40 py-4 text-center">No recent deliveries recorded.</p>
            <% } %>
          </div>
        </div>

      </div>
    </div>

    <!-- TAB 3: DELIVERY HISTORY -->
    <div id="view-history" class="inv-view hidden space-y-4">
      <section class="card-panel p-4">
        <div class="mb-3">
          <h2 class="text-xl text-papaGold font-semibold">Delivery Intake History</h2>
          <p class="text-xs text-white/60">Archived log of confirmed ingredient deliveries.</p>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
        <p class="text-xs text-white/50"><%= (locals.intakeHistory || []).length %> recorded receipt(s).</p>
        <div class="flex flex-wrap items-center gap-2">
          <input type="date" id="historyDateFilter" onchange="filterHistory()"
                 class="h-8 px-2.5 text-xs bg-slate-800 text-white border border-slate-700 rounded focus:border-papaGold focus:outline-none" />
          <input type="text" id="historySearch" oninput="filterHistory()" autocomplete="off"
                 placeholder="Search supplier, item, or date..."
                 class="h-8 px-3 text-xs bg-slate-800 text-white border border-slate-700 rounded focus:border-papaGold focus:outline-none w-56 sm:w-64" />
          <button type="button" onclick="clearHistoryFilters()" 
                  class="h-8 px-3 text-xs font-semibold rounded bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 transition">
            Clear
          </button>
        </div>
      </div>

        <div class="w-full overflow-x-auto">
          <table class="w-full text-sm table-auto" id="historyTable">
            <thead>
              <tr class="border-b border-slate-700/80 text-white/70">
                <th class="text-left py-2 w-44">Received Date</th>
                <th class="text-left py-2 w-40">Supplier / Vendor</th>
                <th class="text-left py-2">Items Summary</th>
                <th class="text-center py-2 w-32">Received By</th>
                <th class="text-right py-2 w-28">Total Cost</th>
              </tr>
            </thead>
            <tbody id="historyTableBody">
              <% (locals.intakeHistory || []).forEach(dh => { 
                  const rawVal = String(dh.received_at || '').trim();
                  const pDate = new Date(rawVal);
                  let formattedDate = rawVal || '—';
                  let isoDate = '';
                  let dateSearchString = '';

                  if (!isNaN(pDate.getTime())) {
                    const y = pDate.getFullYear();
                    const m = String(pDate.getMonth() + 1).padStart(2, '0');
                    const d = String(pDate.getDate()).padStart(2, '0');
                    isoDate = `${y}-${m}-${d}`;
                    
                    const mShort = pDate.toLocaleString('en-US', { month: 'short' }).toLowerCase();
                    const mFull = pDate.toLocaleString('en-US', { month: 'long' }).toLowerCase();
                    dateSearchString = `${mShort} ${d} ${mFull} ${d} ${y} ${mShort} ${y}`;

                    formattedDate = pDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) 
                                    + ' ' + pDate.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
                  }

                  const searchableText = `${formattedDate} ${dh.supplier_name || ''} ${dh.item_summary || ''} ${dh.received_by || ''} ${isoDate} ${dateSearchString}`.toLowerCase();
              %>
                <tr class="history-row border-t border-slate-700 hover:bg-white/5 transition"
                    data-date="<%= isoDate %>"
                    data-search="<%= searchableText %>">
                  <td class="py-2.5 text-white/70 whitespace-nowrap"><%= formattedDate %></td>
                  <td class="py-2.5 text-white/90 whitespace-nowrap font-medium"><%= dh.supplier_name || 'Vendor' %></td>
                  <td class="py-2.5 text-white/70 truncate max-w-xs md:max-w-md" title="<%= dh.item_summary || '' %>">
                    <%= dh.item_summary || `${dh.item_count || 0} line item(s)` %>
                  </td>
                  <td class="py-2.5 text-center text-white/60 whitespace-nowrap"><%= dh.received_by || 'Staff' %></td>
                  <td class="py-2.5 text-right whitespace-nowrap font-semibold text-papaGold">₱<%= Number(dh.total_cost || 0).toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <p id="historyEmpty" class="hidden text-sm text-white/60 py-3">No delivery logs match that search.</p>
      </section>
    </div>
  <% } %>

  <!-- ALL-IN-ONE ROW CLICK MODAL -->
  <div id="restockModal" class="fixed inset-0 bg-black/75 hidden items-center justify-center p-4 z-50">
    <div class="card-panel p-5 w-full max-w-lg space-y-4 shadow-2xl">
      
      <div class="flex justify-between items-center border-b border-slate-700/60 pb-2.5">
        <div>
          <h3 id="modalIngredientName" class="text-base font-semibold text-papaGold">Ingredient Action</h3>
          <p id="modalIngredientStock" class="text-xs text-white/50 mt-0.5"></p>
        </div>
        <button type="button" onclick="closeRestockModal()" class="text-white/60 hover:text-white text-lg">✕</button>
      </div>

      <form method="POST" action="/inventory/adjust" class="space-y-4">
        <input type="hidden" name="ingredient_id" id="modalIngredientId" />

        <!-- Action Pills -->
        <div>
          <label class="text-xs text-white/60 block mb-1.5">Action / Category</label>
          <div class="grid <%= user && ['OWNER', 'MANAGER'].includes(user.role) ? 'grid-cols-3 sm:grid-cols-5' : 'grid-cols-2 sm:grid-cols-4' %> gap-1.5">
            <% if (user && ['OWNER', 'MANAGER'].includes(user.role)) { %>
              <label class="cursor-pointer">
                <input type="radio" name="loss_category" value="RESTOCK" checked onchange="handleModalCategoryChange()" class="peer sr-only">
                <div class="p-2 text-center rounded border border-slate-700 bg-slate-800/80 peer-checked:border-papaGold peer-checked:bg-papaGold/20 peer-checked:text-papaGold transition hover:bg-slate-800">
                  <div class="text-xs">Restock</div>
                </div>
              </label>
            <% } %>

            <label class="cursor-pointer">
              <input type="radio" name="loss_category" value="SPOILAGE" <%= user && user.role === 'KITCHEN' ? 'checked' : '' %> onchange="handleModalCategoryChange()" class="peer sr-only">
              <div class="p-2 text-center rounded border border-slate-700 bg-slate-800/80 peer-checked:border-red-500/80 peer-checked:bg-red-500/10 peer-checked:text-red-300 transition hover:bg-slate-800">
                <div class="text-xs">Expired</div>
              </div>
            </label>

            <label class="cursor-pointer">
              <input type="radio" name="loss_category" value="WASTE" onchange="handleModalCategoryChange()" class="peer sr-only">
              <div class="p-2 text-center rounded border border-slate-700 bg-slate-800/80 peer-checked:border-amber-500/80 peer-checked:bg-amber-500/10 peer-checked:text-amber-300 transition hover:bg-slate-800">
                <div class="text-xs">Burnt / Waste</div>
              </div>
            </label>

            <label class="cursor-pointer">
              <input type="radio" name="loss_category" value="PREP_LOSS" onchange="handleModalCategoryChange()" class="peer sr-only">
              <div class="p-2 text-center rounded border border-slate-700 bg-slate-800/80 peer-checked:border-slate-500 peer-checked:bg-white/10 peer-checked:text-white transition hover:bg-slate-800">
                <div class="text-xs">Prep Loss</div>
              </div>
            </label>

            <label class="cursor-pointer">
              <input type="radio" name="loss_category" value="VARIANCE" onchange="handleModalCategoryChange()" class="peer sr-only">
              <div class="p-2 text-center rounded border border-slate-700 bg-slate-800/80 peer-checked:border-slate-500 peer-checked:bg-white/10 peer-checked:text-white transition hover:bg-slate-800">
                <div class="text-xs">Variance</div>
              </div>
            </label>
          </div>
        </div>

        <!-- Quantity & Impact -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-end">
          <div>
            <label class="text-xs text-white/60 block mb-1">
              Quantity (<span id="modalUnitLabel">units</span>)
            </label>
            <input name="input_qty" id="modalInputQty" type="number" step="any" min="0.01" required 
                   oninput="updateModalCostPreview()" placeholder="e.g. 0.5" 
                   class="w-full bg-slate-800 border border-slate-700 text-white text-sm p-2 rounded focus:border-papaGold focus:outline-none"/>
          </div>

          <div class="bg-black/20 border border-slate-700/60 px-3 py-2 rounded flex flex-col justify-center h-[38px]">
            <span class="text-[10px] uppercase tracking-wide text-white/40 leading-none">Est. Value Impact</span>
            <strong id="modalCostPreview" class="text-xs font-normal text-white/80 mt-1 leading-none">₱0.00</strong>
          </div>
        </div>

        <div>
          <label class="text-xs text-white/60 block mb-1">Reason / Note</label>
          <input type="text" name="reason" required placeholder="e.g. Dropped during lunch rush, spoiled batch" 
                 class="w-full bg-slate-800 border border-slate-700 text-white text-xs p-2 rounded focus:border-papaGold focus:outline-none"/>
        </div>

        <div class="flex justify-end gap-2 pt-2 border-t border-slate-700/60">
          <button type="button" onclick="closeRestockModal()" class="mini-btn">Cancel</button>
          <button type="submit" id="modalSubmitBtn" class="bg-red-800/90 hover:bg-red-700 text-white px-4 py-2 rounded font-semibold text-xs shadow transition">
            Save Deduction
          </button>
        </div>
      </form>
    </div>
  </div>

  <div id="invToast" class="fixed top-5 right-5 z-50 transform translate-y-[-20px] opacity-0 transition-all duration-300 pointer-events-none">
    <div class="card-panel px-4 py-3 rounded shadow-2xl flex items-center gap-2">
      <span id="invToastMsg" class="text-xs font-semibold"></span>
    </div>
  </div>

  <script src="/js/smart-search.js?v=<%= locals.assetVersion || 0 %>"></script>
  <% if (user && ['OWNER', 'MANAGER'].includes(user.role)) { %>
    <script src="/js/inventory-intake.js?v=<%= locals.assetVersion || 0 %>"></script>
  <% } %>
  <script>
    let activeModalCost = 0;
    let showingLowOnly = false;
    const currentUserRole = '<%= user ? user.role : "" %>';

    function showToast(msg) {
      const toast = document.getElementById('invToast');
      const msgEl = document.getElementById('invToastMsg');
      if (!toast || !msgEl) return;
      msgEl.textContent = msg;
      toast.classList.remove('translate-y-[-20px]', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-[-20px]', 'opacity-0', 'pointer-events-none');
      }, 3000);
    }

    function openRestockModal(id, name, unit, stock, cost) {
      activeModalCost = parseFloat(cost) || 0;
      document.getElementById('modalIngredientId').value = id || '';
      document.getElementById('modalIngredientName').textContent = name || 'Ingredient';
      
      const isPrivileged = ['OWNER', 'MANAGER'].includes(currentUserRole);
      const costInfo = isPrivileged ? ` | Cost: ₱${activeModalCost.toFixed(2)} / ${unit || ''}` : '';
      document.getElementById('modalIngredientStock').textContent = `Current Stock: ${stock || '0.00'} ${unit || ''}${costInfo}`;
      
      document.getElementById('modalUnitLabel').textContent = unit || 'units';
      document.getElementById('modalInputQty').value = '';
      document.getElementById('modalCostPreview').textContent = '₱0.00';
      
      if (isPrivileged) {
        const restockRadio = document.querySelector('input[name="loss_category"][value="RESTOCK"]');
        if (restockRadio) restockRadio.checked = true;
      } else {
        const spoilRadio = document.querySelector('input[name="loss_category"][value="SPOILAGE"]');
        if (spoilRadio) spoilRadio.checked = true;
      }
      
      handleModalCategoryChange();

      const modal = document.getElementById('restockModal');
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }

    function closeRestockModal() {
      const modal = document.getElementById('restockModal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    function handleModalCategoryChange() {
      const selected = document.querySelector('input[name="loss_category"]:checked')?.value || 'SPOILAGE';
      const submitBtn = document.getElementById('modalSubmitBtn');
      const costPreview = document.getElementById('modalCostPreview');

      if (!submitBtn || !costPreview) return;

      if (selected === 'RESTOCK') {
        submitBtn.className = 'bg-papaGold hover:bg-yellow-500 text-black px-4 py-2 rounded font-semibold text-xs shadow transition';
        submitBtn.textContent = 'Save Restock';
        costPreview.className = 'text-xs font-normal text-white/80 mt-1 leading-none';
      } else {
        submitBtn.className = 'bg-red-800/90 hover:bg-red-700 text-white px-4 py-2 rounded font-semibold text-xs shadow transition';
        submitBtn.textContent = 'Save Deduction';
        costPreview.className = 'text-xs font-normal text-red-400 mt-1 leading-none';
      }
      updateModalCostPreview();
    }

    function updateModalCostPreview() {
      const qty = parseFloat(document.getElementById('modalInputQty')?.value) || 0;
      const total = qty * activeModalCost;
      const preview = document.getElementById('modalCostPreview');
      if (preview) preview.textContent = `₱${total.toFixed(2)}`;
    }

    function toggleLowStockFilter() {
      showingLowOnly = !showingLowOnly;
      const btn = document.getElementById('lowStockToggleBtn');
      if (btn) {
        btn.textContent = showingLowOnly ? 'Show All Items' : 'Show Low Stock Only';
        btn.classList.toggle('bg-amber-500', showingLowOnly);
        btn.classList.toggle('text-black', showingLowOnly);
        btn.classList.toggle('text-amber-400', !showingLowOnly);
      }
      filterInventory();
    }

    function filterInventory() {
      const query = (document.getElementById('inventorySearch')?.value || '').trim().toLowerCase();
      const rows = document.querySelectorAll('#inventoryTable tbody tr.inventory-row');
      let visible = 0;

      rows.forEach(row => {
        const isLow = row.getAttribute('data-is-low') === 'true';
        const searchBlob = (row.getAttribute('data-search') || '').toLowerCase();
        const matchesQuery = !query || searchBlob.includes(query);
        const matchesLow = !showingLowOnly || isLow;

        if (matchesQuery && matchesLow) {
          row.style.display = '';
          visible++;
        } else {
          row.style.display = 'none';
        }
      });

      const emptyEl = document.getElementById('inventoryEmpty');
      if (emptyEl) {
        emptyEl.classList.toggle('hidden', visible > 0);
      }
    }

    function filterHistory() {
      const dateVal = (document.getElementById('historyDateFilter')?.value || '').trim();
      const rawSearch = (document.getElementById('historySearch')?.value || '').trim().toLowerCase();

      // Normalize "sept" to "sep" so typing "sept 26" or "sep 26" behaves identically
      const normalizedSearch = rawSearch.replace(/\bsept\b/g, 'sep');
      const searchTokens = normalizedSearch.replace(/,/g, ' ').split(/\s+/).filter(Boolean);

      const rows = document.querySelectorAll('#historyTable tbody tr.history-row');
      let visible = 0;

      rows.forEach(row => {
        const rowDate = row.getAttribute('data-date') || ''; // e.g. "2026-09-26"
        const searchBlob = (row.getAttribute('data-search') || '').toLowerCase();

        // calendar picker checker
        const matchesCalendar = !dateVal || rowDate === dateVal;

        // text input tokens check
        const matchesTokens = searchTokens.length === 0 || searchTokens.every(token => {
          // If the token is a 1 or 2 digit day (e.g. "26" or "5")
          if (/^\d{1,2}$/.test(token)) {
            const dayNum = parseInt(token, 10);
            const paddedDay = String(dayNum).padStart(2, '0');
            // check if it matches the day in ISO date or as a standalone word
            const regex = new RegExp(`(^|\\D)${paddedDay}(\\D|$)`);
            return regex.test(rowDate) || new RegExp(`\\b${dayNum}\\b`).test(searchBlob);
          }
          return searchBlob.includes(token);
        });

        if (matchesCalendar && matchesTokens) {
          row.style.display = '';
          visible++;
        } else {
          row.style.display = 'none';
        }
      });

      const emptyMsg = document.getElementById('historyEmpty');
      if (emptyMsg) {
        emptyMsg.classList.toggle('hidden', visible > 0);
      }
    }

    function clearHistoryFilters() {
      const d = document.getElementById('historyDateFilter');
      const s = document.getElementById('historySearch');
      if (d) d.value = '';
      if (s) s.value = '';
      filterHistory();
    }

    document.getElementById('inventorySearch')?.addEventListener('keypress', e => {
      if (e.key === 'Enter') { e.preventDefault(); filterInventory(); }
    });

    document.getElementById('historySearch')?.addEventListener('keypress', e => {
      if (e.key === 'Enter') { e.preventDefault(); filterHistory(); }
    });
  </script>
</body>
</html>