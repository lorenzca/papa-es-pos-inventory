<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Papa Es POS - Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css?v=<%= locals.assetVersion || 0 %>" />
  <script>tailwind.config={theme:{extend:{colors:{papaRed:'#8B0000',papaGold:'#D4AF37'}}}}</script>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md card-panel p-6">
    <div class="flex items-center gap-3 mb-5">
      <img src="/img/PapaEs_Logo.png" alt="Papa Es Logo" class="brand-logo" />
      <div>
        <h1 class="text-2xl font-bold text-papaGold">Papa Es Diner</h1>
        <p class="text-white/70 text-sm">Sales & Inventory System</p>
      </div>
    </div>
    <% if (error) { %>
      <div class="bg-red-900/30 border border-red-600 text-red-300 p-3 rounded mb-4"><%= error %></div>
    <% } %>
    <form method="POST" action="/login" class="space-y-4">
      <div>
        <label class="text-slate-300 text-sm">Username</label>
        <input type="text" name="username" required class="w-full mt-1 p-3 rounded bg-slate-800 text-white border border-slate-700" />
      </div>
      <div>
        <label class="text-slate-300 text-sm">Password</label>
        <input type="password" name="password" required class="w-full mt-1 p-3 rounded bg-slate-800 text-white border border-slate-700" />
      </div>
      <button class="w-full bg-papaRed hover:bg-red-900 text-papaGold font-semibold py-3 rounded">Login</button>
    </form>
    <p class="text-xs text-slate-500 mt-4">Default: admin / papaes2026</p>
  </div>
</body>
</html>
