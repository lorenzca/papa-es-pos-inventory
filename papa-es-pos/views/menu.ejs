<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Menu</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css?v=<%= locals.assetVersion || 0 %>" />
  <script>tailwind.config={theme:{extend:{colors:{papaRed:'#8B0000',papaGold:'#D4AF37'}}}}</script>
</head>
<body class="text-white p-4 md:p-6">
  <%
    const initialsOf = (name) => String(name || '?')
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((word) => word[0].toUpperCase())
      .join('') || '?';
  %>
  <%- include('partials/header', { user, pageTitle: 'Menu & Recipe Control' }) %>

  <nav class="mb-4 flex flex-wrap gap-2 text-sm">
    <a href="/dashboard" class="px-3 py-2 rounded bg-white/10 hover:bg-white/20">Dashboard</a>
    <a href="/reports" class="px-3 py-2 rounded bg-white/10 hover:bg-white/20">Reports</a>
    <a href="/logout" class="px-3 py-2 rounded bg-red-800/80 hover:bg-red-700">Logout</a>
  </nav>

  <%# panel picker ---------------------------------------------------------------- %>
  <section class="card-panel p-4 mb-4">
    <p class="text-xs uppercase tracking-wide text-white/50 mb-2">Choose what to do</p>
    <div class="flex flex-wrap gap-2">
      <% panels.forEach((entry) => { %>
        <a href="/menu?panel=<%= entry.key %><%= selectedMenuId ? '&item=' + selectedMenuId : '' %>"
           class="tab-btn <%= panel === entry.key ? 'is-active' : '' %>"><%= entry.label %></a>
      <% }) %>
    </div>
  </section>

  <section class="card-panel p-4">
    <div class="mb-3">
      <h2 class="text-xl text-papaGold font-semibold"><%= panelMeta.label %></h2>
      <p class="text-xs text-white/60"><%= panelMeta.hint %></p>
    </div>
<%# menu list ---------------------------------------------------------------- %>
    <% if (panel === 'list') { %>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
        <p class="text-xs text-white/50"><%= menuItems.length %> item(s) on file.</p>
        <div class="flex items-center gap-2">
          <input type="text" id="menuSearch" oninput="filterMenuList()" autocomplete="off"
                 placeholder="Search menu"
                 class="bg-slate-800 text-sm text-white border border-slate-700 focus:border-papaGold focus:outline-none p-2 rounded min-w-[220px]" />
          <button type="button" onclick="filterMenuList()" class="mini-btn">Search</button>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm" id="menuListTable">
          <thead>
            <tr>
              <th class="text-left">Image</th><th class="text-left">Name</th>
              <th class="text-left">Parent Group</th><th class="text-left">Sub-Category</th>
              <th class="text-right">Selling</th><th class="text-right">Recipe Cost</th>
              <th class="text-left">Status</th><th></th>
            </tr>
          </thead>
          <tbody>
          <% menuItems.forEach((m) => { %>
            <tr class="border-t border-slate-700 <%= m.is_active ? '' : 'opacity-60' %>"
                data-search="<%= m.item_name %> | <%= m.parent_group || 'General' %> <%= m.sub_category || m.category || '' %>">
              <td class="py-1">
                <span class="card-thumb card-thumb-sm">
                  <span class="card-thumb-fallback text-xs"><%= initialsOf(m.item_name) %></span>
                  <% if (m.image_url) { %>
                    <img src="<%= m.image_url %>" alt="" loading="lazy" onerror="this.remove()" />
                  <% } %>
                </span>
              </td>
              <td><%= m.item_name %></td>
              <td><span class="bg-white/10 px-2 py-0.5 rounded text-xs"><%= m.parent_group || 'General' %></span></td>
              <td><%= m.sub_category || m.category %></td>
              <td class="text-right">₱<%= Number(m.sell_price).toFixed(2) %></td>
              <td class="text-right">₱<%= Number(m.recipe_cost || 0).toFixed(2) %></td>
              <td class="text-xs <%= m.is_active ? 'text-green-300' : 'text-red-300' %>"><%= m.is_active ? 'Active' : 'Hidden' %></td>
              <td class="text-right whitespace-nowrap">
                <a href="/menu?panel=edit&item=<%= m.id %>" class="mini-btn">Edit</a>
                <a href="/menu?panel=recipe&item=<%= m.id %>" class="mini-btn">Recipe</a>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
        <p id="menuListEmpty" class="hidden text-sm text-white/60 py-3">No menu item matches that search.</p>
        <% if (!menuItems.length) { %>
          <p class="text-sm text-white/60 py-3">No menu items yet. Use Add Menu Item to create the first one.</p>
        <% } %>
      </div>
    <% } %>
<%# add menu item ---------------------------------------------------------------- %>
    <% if (panel === 'add') { %>
      <form method="POST" action="/menu" enctype="multipart/form-data" class="space-y-3 max-w-xl">
        <div>
          <label class="text-xs text-white/60 block mb-1">Item name</label>
          <input name="item_name" required placeholder="e.g., Burger Steak Meal"
                 class="w-full bg-slate-800 p-2 rounded text-sm border border-slate-700 focus:border-papaGold focus:outline-none" />
        </div>

        <div class="relative">
          <label class="text-xs text-white/60 block mb-1">Parent Group (main cuisine / theme)</label>
          <input type="text" id="addParentInput" name="parent_group" required autocomplete="off"
                 placeholder="e.g., The Diner, Mediterranean, Korean"
                 onfocus="showDropdown('addParentDropdown')"
                 oninput="filterDropdown('addParentInput', 'addParentDropdown')"
                 class="w-full bg-slate-800 p-2 rounded text-sm border border-slate-700 focus:border-papaGold focus:outline-none" />
          <div id="addParentDropdown" class="hidden absolute z-50 left-0 right-0 top-full mt-1 bg-slate-800 border border-slate-700 rounded shadow-lg max-h-40 overflow-y-auto">
            <% parentGroups.forEach((pg) => { %>
              <div data-value="<%= pg %>" data-target="addParentInput" data-dropdown="addParentDropdown"
                   class="option-row p-2 text-sm text-white hover:bg-papaGold hover:text-black cursor-pointer transition"><%= pg %></div>
            <% }) %>
          </div>
        </div>

        <div class="relative">
          <label class="text-xs text-white/60 block mb-1">Sub-Category (course / food type)</label>
          <input type="text" id="addSubInput" name="sub_category" required autocomplete="off"
                 placeholder="e.g., Rice Meal, Burger, Sides, Drinks"
                 onfocus="showDropdown('addSubDropdown')"
                 oninput="filterDropdown('addSubInput', 'addSubDropdown')"
                 class="w-full bg-slate-800 p-2 rounded text-sm border border-slate-700 focus:border-papaGold focus:outline-none" />
          <div id="addSubDropdown" class="hidden absolute z-50 left-0 right-0 top-full mt-1 bg-slate-800 border border-slate-700 rounded shadow-lg max-h-40 overflow-y-auto">
            <% subCategories.forEach((sc) => { %>
              <div data-value="<%= sc %>" data-target="addSubInput" data-dropdown="addSubDropdown"
                   class="option-row p-2 text-sm text-white hover:bg-papaGold hover:text-black cursor-pointer transition"><%= sc %></div>
            <% }) %>
          </div>
        </div>

        <div>
          <label class="text-xs text-white/60 block mb-1">Selling price</label>
          <input name="sell_price" type="number" step="0.01" min="0" required placeholder="0.00"
                 class="w-full bg-slate-800 p-2 rounded text-sm border border-slate-700 focus:border-papaGold focus:outline-none" />
        </div>

        <div>
          <label class="text-xs text-white/60 block mb-1">Photo (upload from this PC)</label>
          <input name="image_file" type="file" accept="image/*"
                 class="w-full bg-slate-800 p-2 rounded text-sm file:mr-3 file:rounded file:border-0 file:bg-papaGold file:px-3 file:py-1 file:font-semibold file:text-black" />
          <input name="image_url" type="url" placeholder="or paste an image URL (optional)"
                 class="w-full bg-slate-800 p-2 rounded text-sm border border-slate-700 mt-2" />
        </div>

        <button class="w-full bg-papaGold text-black px-4 py-3 rounded font-bold">Create Menu Item</button>
        <p class="text-xs text-white/50">Saving opens the Recipe panel for this item, so its ingredients can be linked right away.</p>
      </form>
    <% } %>
<%# ---- Item picker (Edit + Recipe share it) ---------------------------- %>
<%# This used to be every item printed as a button, which turned into a wall  %>
<%# of pills once the menu grew past a screenful. It is a search box with a   %>
<%# dropdown now, built the same way as the category boxes further down the   %>
<%# page so there is only one dropdown idea on this screen to learn. Picking  %>
<%# a row still just loads /menu?panel=…&item=… , exactly like the buttons    %>
<%# did, so nothing downstream had to change.                                 %>
    <% if (panel === 'edit' || panel === 'recipe') { %>
      <div class="mb-4 relative max-w-sm">
        <label class="text-xs text-white/60 block mb-1">Which item?</label>
        <input type="text" id="pickerInput" autocomplete="off"
               placeholder="Type an item name…"
               value="<%= selectedItem ? selectedItem.item_name : '' %>"
               onfocus="openPicker()" oninput="filterPicker()"
               class="w-full bg-slate-800 p-2 rounded text-sm text-white border border-slate-700 focus:border-papaGold focus:outline-none" />
        <div id="pickerDropdown" class="hidden absolute z-50 left-0 right-0 top-full mt-1 bg-slate-800 border border-slate-700 rounded shadow-lg max-h-60 overflow-y-auto custom-scrollbar">
          <% menuNames.forEach((row) => { %>
            <div data-go="/menu?panel=<%= panel %>&item=<%= row.id %>" data-search="<%= row.item_name %>"
                 class="picker-row p-2 text-sm text-white hover:bg-papaGold hover:text-black cursor-pointer transition <%= Number(selectedMenuId) === Number(row.id) ? 'text-papaGold font-semibold' : '' %>"><%= row.item_name %><%= row.is_active ? '' : ' (hidden)' %></div>
          <% }) %>
        </div>
        <p id="pickerEmpty" class="hidden text-xs text-white/60 pt-2">No item matches that search.</p>
        <% if (!menuNames.length) { %>
          <p class="text-sm text-white/60">No menu items yet — add one first.</p>
        <% } %>
      </div>
    <% } %>
<%# edit item ------------------------------------------------------- %>
    <% if (panel === 'edit' && selectedItem) { %>
      <form method="POST" action="/menu/<%= selectedItem.id %>/update" enctype="multipart/form-data" class="space-y-3 max-w-xl border-t border-slate-700 pt-4">
        <div>
          <label class="text-xs text-white/60 block mb-1">Item name</label>
          <input name="item_name" required value="<%= selectedItem.item_name %>"
                 class="w-full bg-slate-800 p-2 rounded text-sm border border-slate-700 focus:border-papaGold focus:outline-none" />
        </div>

        <div class="relative">
          <label class="text-xs text-white/60 block mb-1">Parent Group (main cuisine / theme)</label>
          <input type="text" id="editParentInput" name="parent_group" required autocomplete="off"
                 value="<%= selectedItem.parent_group || '' %>"
                 onfocus="showDropdown('editParentDropdown')"
                 oninput="filterDropdown('editParentInput', 'editParentDropdown')"
                 class="w-full bg-slate-800 p-2 rounded text-sm border border-slate-700 focus:border-papaGold focus:outline-none" />
          <div id="editParentDropdown" class="hidden absolute z-50 left-0 right-0 top-full mt-1 bg-slate-800 border border-slate-700 rounded shadow-lg max-h-40 overflow-y-auto">
            <% parentGroups.forEach((pg) => { %>
              <div data-value="<%= pg %>" data-target="editParentInput" data-dropdown="editParentDropdown"
                   class="option-row p-2 text-sm text-white hover:bg-papaGold hover:text-black cursor-pointer transition"><%= pg %></div>
            <% }) %>
          </div>
        </div>

        <div class="relative">
          <label class="text-xs text-white/60 block mb-1">Sub-Category (course / food type)</label>
          <input type="text" id="editSubInput" name="sub_category" required autocomplete="off"
                 value="<%= selectedItem.sub_category || selectedItem.category || '' %>"
                 onfocus="showDropdown('editSubDropdown')"
                 oninput="filterDropdown('editSubInput', 'editSubDropdown')"
                 class="w-full bg-slate-800 p-2 rounded text-sm border border-slate-700 focus:border-papaGold focus:outline-none" />
          <div id="editSubDropdown" class="hidden absolute z-50 left-0 right-0 top-full mt-1 bg-slate-800 border border-slate-700 rounded shadow-lg max-h-40 overflow-y-auto">
            <% subCategories.forEach((sc) => { %>
              <div data-value="<%= sc %>" data-target="editSubInput" data-dropdown="editSubDropdown"
                   class="option-row p-2 text-sm text-white hover:bg-papaGold hover:text-black cursor-pointer transition"><%= sc %></div>
            <% }) %>
          </div>
        </div>

        <div>
          <label class="text-xs text-white/60 block mb-1">Selling price</label>
          <input name="sell_price" type="number" step="0.01" min="0" required value="<%= selectedItem.sell_price %>"
                 class="w-full bg-slate-800 p-2 rounded text-sm border border-slate-700 focus:border-papaGold focus:outline-none" />
        </div>

        <div>
          <label class="text-xs text-white/60 block mb-1">Photo</label>
          <input type="hidden" name="existing_image_url" value="<%= selectedItem.image_url || '' %>" />
          <input name="image_file" type="file" accept="image/*"
                 class="w-full bg-slate-800 p-2 rounded text-sm file:mr-3 file:rounded file:border-0 file:bg-papaGold file:px-3 file:py-1 file:font-semibold file:text-black" />
          <input name="image_url" type="url" placeholder="or paste a replacement image URL"
                 class="w-full bg-slate-800 p-2 rounded text-sm border border-slate-700 mt-2" />
          <% if (selectedItem.image_url) { %>
            <img src="<%= selectedItem.image_url %>" class="h-20 w-32 rounded object-cover border border-white/20 mt-2" alt="Current photo" />
          <% } %>
        </div>

        <%# Unchecked simply omits is_active, which the controller reads as 0. %>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="is_active" value="1" <%= selectedItem.is_active ? 'checked' : '' %> /> Show this item in the POS
        </label>

        <button class="w-full bg-papaGold text-black px-4 py-3 rounded font-bold">Save Changes</button>
      </form>

      <form method="POST" action="/menu/<%= selectedItem.id %>/delete" class="max-w-xl mt-3"
            onsubmit="return confirm('Remove <%= selectedItem.item_name %>? If it appears on past sales it is hidden from the POS instead of deleted.')">
        <button type="submit" class="w-full bg-red-800/80 px-4 py-3 rounded hover:bg-red-700 text-sm font-semibold">Remove Item</button>
      </form>
    <% } %>
<%# edit recipe ----------------------------------------------------- %>
    <% if (panel === 'recipe' && selectedItem) { %>
      <div class="border-t border-slate-700 pt-4">
        <p class="text-sm mb-3">
          Recipe for <span class="text-papaGold font-semibold"><%= selectedItem.item_name %></span>
          — quantities are per one serving, in each ingredient's own unit.
        </p>

        <% if (!ingredients.length) { %>
          <p class="text-sm text-white/60">No ingredients exist yet. Add them in <a href="/inventory" class="underline">Inventory</a> first.</p>
        <% } else { %>
        <form method="POST" action="/menu/recipe" id="recipeForm" class="space-y-3">
          <input type="hidden" name="menu_item_id" value="<%= selectedItem.id %>" />
          <table class="w-full text-sm" id="recipeTable">
            <thead><tr><th class="text-left">Ingredient</th><th class="text-left">Qty per serving</th><th></th></tr></thead>
            <tbody>
              <% selectedRecipe.forEach((row) => { %>
                <tr>
                  <td class="py-1 pr-2">
                    <select name="ingredient_id" class="w-full bg-slate-800 p-2 rounded border border-slate-700">
                      <% ingredients.forEach((ing) => { %>
                        <option value="<%= ing.id %>" <%= Number(ing.id) === Number(row.ingredient_id) ? 'selected' : '' %>><%= ing.ingredient_name %> (<%= ing.unit_measure %>)</option>
                      <% }) %>
                    </select>
                  </td>
                  <td class="pr-2"><input name="qty_required" type="number" min="0.0001" step="0.0001" value="<%= row.qty_required %>" class="w-full bg-slate-800 p-2 rounded border border-slate-700" /></td>
                  <td class="text-right"><button type="button" class="mini-btn mini-btn-danger" onclick="removeRow(this)">Remove</button></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <div class="flex flex-wrap gap-2">
            <button type="button" onclick="addIngredientRow()" class="mini-btn">Add Ingredient</button>
            <button class="bg-papaGold text-black px-4 py-2 rounded font-bold text-sm">Save Recipe</button>
          </div>
          <p class="text-xs text-white/50">Saving replaces the whole recipe — rows left blank or at zero are dropped.</p>
        </form>
        <% } %>
      </div>
    <% } %>

    <% if ((panel === 'edit' || panel === 'recipe') && !selectedItem && menuNames.length) { %>
      <p class="text-sm text-white/60 border-t border-slate-700 pt-4">Pick an item above to continue.</p>
    <% } %>
  </section>

  <%# panel scripts ---------------------------------------------------- %>
  <%# only the active panels script is sent so there is no code on the page  %>
  <script src="/js/smart-search.js?v=<%= locals.assetVersion || 0 %>"></script>

  <% if (panel === 'list') { %>
  <script>
    function filterMenuList() {
      const query = document.getElementById('menuSearch').value;
      const rows = document.querySelectorAll('#menuListTable tbody tr');
      const shown = PapaSearch.applyToElements(query, rows);
      document.getElementById('menuListEmpty').classList.toggle('hidden', shown > 0);
    }

    document.getElementById('menuSearch').addEventListener('keypress', function (event) {
      if (event.key === 'Enter') { event.preventDefault(); filterMenuList(); }
    });
  </script>
  <% } %>

  <% if (panel === 'edit' || panel === 'recipe') { %>
  <script>
    // item dropdown. filtering is the same job as filtering the menu list,
    // so it goes through the same matcher "bkd" still finds baked tahong
    // best match floats to the top while you type, so enter is usually right
    function openPicker() { document.getElementById('pickerDropdown').classList.remove('hidden'); }

    function filterPicker() {
      const dropdown = document.getElementById('pickerDropdown');
      dropdown.classList.remove('hidden');
      const query = document.getElementById('pickerInput').value;
      const rows = dropdown.querySelectorAll('.picker-row');
      const shown = PapaSearch.applyToElements(query, rows, { reorder: query.trim().length > 0 });
      document.getElementById('pickerEmpty').classList.toggle('hidden', shown > 0);
    }

    document.addEventListener('click', function (event) {
      const row = event.target.closest('.picker-row');
      if (row) { window.location.href = row.dataset.go; return; }
      if (!event.target.closest('#pickerInput')) {
        document.getElementById('pickerDropdown').classList.add('hidden');
      }
    });

    // enter opens whichever row is sitting at the top of the filtered list
    document.getElementById('pickerInput').addEventListener('keydown', function (event) {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      const rows = document.querySelectorAll('#pickerDropdown .picker-row');
      for (const row of rows) {
        if (!row.classList.contains('hidden') && row.style.display !== 'none') {
          window.location.href = row.dataset.go;
          return;
        }
      }
    });
  </script>
  <% } %>

  <% if (panel === 'add' || panel === 'edit') { %>
  <script>
    function showDropdown(id) { document.getElementById(id).classList.remove('hidden'); }

    // typing "med" (or "mediteranean") still surfaces "Mediterranean" the
    // same matcher the cashier facing screens use.
    function filterDropdown(inputId, dropdownId) {
      const dropdown = document.getElementById(dropdownId);
      dropdown.classList.remove('hidden');
      PapaSearch.applyToElements(document.getElementById(inputId).value, dropdown.querySelectorAll('.option-row'));
    }

    document.addEventListener('click', function (event) {
      const option = event.target.closest('.option-row');
      if (option) {
        document.getElementById(option.dataset.target).value = option.dataset.value;
        document.getElementById(option.dataset.dropdown).classList.add('hidden');
        return;
      }
      if (!event.target.closest('.relative')) {
        document.querySelectorAll('[id$="Dropdown"]').forEach((el) => el.classList.add('hidden'));
      }
    });
  </script>
  <% } %>

  <% if (panel === 'recipe' && selectedItem && ingredients.length) { %>
  <script>
    const INGREDIENTS = <%- JSON.stringify(ingredients.map((ing) => ({ id: ing.id, name: ing.ingredient_name, unit: ing.unit_measure }))) %>;

    function addIngredientRow() {
      const tbody = document.querySelector('#recipeTable tbody');
      const options = INGREDIENTS.map((ing) => '<option value="' + ing.id + '">' + ing.name + ' (' + ing.unit + ')</option>').join('');
      const tr = document.createElement('tr');
      tr.innerHTML =
        '<td class="py-1 pr-2"><select name="ingredient_id" class="w-full bg-slate-800 p-2 rounded border border-slate-700">' + options + '</select></td>' +
        '<td class="pr-2"><input name="qty_required" type="number" min="0.0001" step="0.0001" class="w-full bg-slate-800 p-2 rounded border border-slate-700" required /></td>' +
        '<td class="text-right"><button type="button" class="mini-btn mini-btn-danger" onclick="removeRow(this)">Remove</button></td>';
      tbody.appendChild(tr);
    }

    function removeRow(button) { button.closest('tr').remove(); }

    // An item with no recipe yet opens with one empty row ready to fill in.
    if (!document.querySelector('#recipeTable tbody tr')) addIngredientRow();
  </script>
  <% } %>
</body>
</html>
